# Copy to .env on the server. Never commit .env.
PORT=3000
HOST=0.0.0.0

# Optional PIN for /home and /amp. Leave blank for no gate. Generate with: npm run hash-pin
PARENT_PIN_HASH=

# Todoist (P2)
TODOIST_TOKEN=
TODOIST_TOP3_QUERY=

# Calendars (P1). Google Calendar > Settings > calendar > "Secret address in iCal format".
# Comma-separated. Treat these like passwords.
ICS_URLS=

# AMP (v2, optional)
AMP_URL=
AMP_USERNAME=
AMP_PASSWORD=
