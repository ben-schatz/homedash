# Copy to .env on the server. Never commit .env.
PORT=3000
HOST=0.0.0.0

# Parent login. Generate with: npm run hash-password
PARENT_PASSWORD_HASH=
# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Todoist (P2)
TODOIST_TOKEN=
TODOIST_TOP3_QUERY=

# Calendars (P1). Google Calendar > Settings > calendar > "Secret address in iCal format".
# Comma-separated. Treat these like passwords.
ICS_URLS=

# AMP (v2, optional)
AMP_URL=
AMP_USERNAME=
AMP_PASSWORD=
